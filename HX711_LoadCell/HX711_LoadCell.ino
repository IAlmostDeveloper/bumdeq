/**
 *  HX711_LoadCell:
 *
 *  Чтение значений тензодатчика через 24-битный АЦП HX711,
 *  перевод в килограммы и вывод в последовательный порт.
 *
 *  Библиотека: "HX711 Arduino Library" by Bogdan Necula (bogde/HX711),
 *  установить через Менеджер библиотек Arduino IDE.
 *
 *  Подключение:
 *    HX711 VCC -> 5V (или 3.3V на ESP)
 *    HX711 GND -> GND
 *    HX711 DT  -> LOADCELL_DOUT_PIN
 *    HX711 SCK -> LOADCELL_SCK_PIN
 */

#include "HX711.h"

// ─────────────────────────── Настройки пинов ───────────────────────────
// При необходимости поменяйте номера под свою плату и разводку.
const uint8_t LOADCELL_DOUT_PIN = 9;   // вывод данных HX711 (DT)
const uint8_t LOADCELL_SCK_PIN  = 10;  // тактовый вывод HX711 (SCK)

// ──────────────────────────── Настройки чтения ─────────────────────────
// Сколько выборок усреднять за одно измерение: больше — стабильнее, но медленнее.
const uint8_t SAMPLES_PER_READING = 10;
// Сколько выборок усреднять при тарировании (поиск нуля) на старте.
const uint8_t TARE_SAMPLES        = 20;

// ──────────────────────────────── Калибровка ───────────────────────────
// COUNTS_PER_KG — сколько отсчётов АЦП приходится на 1 кг нагрузки.
//
// Способ 1 (рекомендуется) — измерить эталонным весом:
//   1. На старте скетч сам находит "ноль" (tare) без нагрузки.
//   2. Положите известную массу M (кг) и посмотрите сырое значение raw.
//   3. COUNTS_PER_KG = (raw - ноль) / M   ← подставьте сюда полученное число.
//
// Способ 2 (теоретический, из даташита датчика, точность ±5..10%):
//   COUNTS_PER_KG = S * Gain * 2^24 / Cmax
//     S     — паспортная чувствительность в В/В  (мВ/В * 1e-3)
//     Gain  — усиление HX711 (по умолчанию канал A = 128)
//     2^24  = 16 777 216  (полный размах 24-битного кода)
//     Cmax  — номинальная нагрузка датчика, кг
//   Пример: S = 2 мВ/В, Cmax = 50 кг, Gain = 128:
//     0.002 * 128 * 16777216 / 50 ≈ 85899 отсчётов/кг
//
// ВАЖНО: при питании от E+/E- HX711 (≈5 В вместо 10 В номинала) это число
// НЕ меняется — датчик ратиометричен, опора АЦП масштабируется вместе с
// сигналом, поэтому возбуждение в формулу не входит.
const float COUNTS_PER_KG = 85899.0f;   // TODO: заменить на свой откалиброванный коэффициент

// ───────────────────────────── Глобальные объекты ──────────────────────
HX711 scale;
long  zeroOffset = 0;   // сырое значение при нулевой нагрузке (находится при тарировании)

// ───────────────────────── Перевод отсчётов в кг ───────────────────────
// Основной метод: линейное преобразование сырого кода АЦП в килограммы.
//   масса = (сырое_значение - ноль) / COUNTS_PER_KG
float rawToKilograms(long raw) {
    return (float)(raw - zeroOffset) / COUNTS_PER_KG;
}

// ───────────────────────────────── setup ───────────────────────────────
void setup() {
    Serial.begin(115200);
    Serial.println("\nStarting HX711_LoadCell");

    // Инициализация АЦП: указываем пины данных и тактирования.
    scale.begin(LOADCELL_DOUT_PIN, LOADCELL_SCK_PIN);

    // Тарирование: запоминаем сырое значение без нагрузки как "ноль".
    // wait_ready_timeout не даёт зависнуть, если датчик не отвечает.
    if (scale.wait_ready_timeout(1000)) {
        zeroOffset = scale.read_average(TARE_SAMPLES);
        Serial.print("Тарирование завершено, ноль = ");
        Serial.println(zeroOffset);
    } else {
        Serial.println("HX711 не найден при тарировании — проверьте подключение");
    }
}

// ───────────────────────────────── loop ────────────────────────────────
void loop() {
    // is_ready() возвращает true, когда у HX711 готовы новые данные.
    // Без этой проверки read() блокирующе ждёт готовности датчика.
    if (scale.is_ready()) {
        long  reading = scale.read_average(SAMPLES_PER_READING);
        float kg      = rawToKilograms(reading);

        Serial.print(reading);
        Serial.print('\t');
        Serial.print(kg, 3);   // 3 знака после запятой
        Serial.println(" кг");
    } else {
        Serial.println("HX711 не найден — проверьте подключение DT/SCK");
        delay(500);
    }
}
